# ─────────────────────────────────────────────────────────────────────────────
# Face API — Environment template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
GIN_MODE=debug          # use "release" in production
PORT=8080
MODELS_DIR=./models

# ── PASETO token signing key ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
PASETO_SECRET=REPLACE_WITH_64_HEX_CHARS

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=faceapi
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=faceapi
POSTGRES_PORT=5432
DB_URL=postgres://faceapi:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/faceapi?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_PORT=6379
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * only for local dev)
ALLOWED_ORIGINS=*

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_REPLACE
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE
# Where Paystack redirects after payment (your frontend billing callback URL)
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/billing/callback

# ── App environment ────────────────────────────────────────────────────────────
# "dev" or "prod" — namespaces Redis keys so envs never share data
APP_ENV=dev

# ── pgAdmin (docker compose --profile dev only) ───────────────────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
PGADMIN_PORT=5050
